{
  "name": "godfall-the-flesh-war",
  "private": true,
  "version": "1.1.0",
  "description": "Three-faction real-time strategy game: Godfall: The Flesh War",
  "author": "recursive-ai-dev <psychcoherence@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "test:battles": "node scripts/test.mjs test/simulation.ts",
    "test:browser": "node scripts/browser-check.mjs && node scripts/mobile-check.mjs",
    "dist:linux": "npm run build && electron-builder --linux deb rpm AppImage --x64 --publish never"
  },
  "build": {
    "appId": "com.recursiveaidev.godfall",
    "productName": "Godfall: The Flesh War",
    "executableName": "godfall-the-flesh-war",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "linux": {
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "recursive-ai-dev <psychcoherence@gmail.com>",
      "synopsis": "Three-faction RTS: Godfall: The Flesh War",
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "2.3.0"
  }
}
